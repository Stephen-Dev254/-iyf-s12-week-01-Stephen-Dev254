        .metadata { color: #6b7280; font-size: 0.95rem; margin-bottom: 1.5rem; border-bottom: 1px solid #e5e7eb; padding-bottom: 1rem; }
        .featured-image { width: 100%; height: 400px; object-fit: cover; border-radius: 6px; margin-bottom: 2rem; }
        h2 { font-size: 1.75rem; color: #111827; margin-top: 2rem; margin-bottom: 1rem; }
        p { margin-bottom: 1.25rem; font-size: 1.1rem; color: #374151; }
        .related-posts { margin-top: 3.5rem; border-top: 2px solid #e5e7eb; padding-top: 2rem; }
        .related-posts h3 { font-size: 1.5rem; color: #111827; margin-bottom: 1rem; }
